# Supabase project (Project settings > API). Leave both unset to run in
# local-only mode: no accounts, everything stays in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key is public by design. Never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
