# Supabase project (Project settings > API). Leave both unset to run in
# local-only mode: no accounts, everything stays in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key is public by design. Never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# AI features (server-side only; never prefix with NEXT_PUBLIC_). Without a key the AI buttons
# say AI is not switched on, and the rest of the app works as before.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
# ANTHROPIC_MODEL=
# Optional per-user limits. Defaults: 30 calls per rolling 24 hours, 5 per rolling minute.
# AI_DAILY_LIMIT=30
# AI_BURST_LIMIT=5
# AI_GLOBAL_DAILY_LIMIT=300   # calls across all users per rolling 24 hours (spending cap)
# Local development only (ignored in production builds): AI_MOCK=1 returns canned answers, AI_MOCK=fail simulates an outage.
# AI_MOCK=1
